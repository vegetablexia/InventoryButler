{
	"schemaVersion": 1,
	"id": "inventorybutler",
	"version": "${version}",
	"name": "Inventory Butler",
	"description": "物品管家 —— 泰拉瑞亚风格的物品栏管理套件：一键整理、垃圾桶、收藏锁定、归位标记。Terraria-style inventory management: sort, trash can, favorite lock and slot pinning.",
	"authors": [
		"vegetablexia"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/inventorybutler/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.inventorybutler.InventoryButler"
		],
		"client": [
			"com.inventorybutler.client.InventoryButlerClient"
		]
	},
	"mixins": [
		"inventorybutler.mixins.json",
		{
			"config": "inventorybutler.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
